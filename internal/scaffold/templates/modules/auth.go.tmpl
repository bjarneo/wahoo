package app

import (
	"net/http"

	"github.com/bjarneo/wahoo/server"
)

func registerAuth(runtime *server.Server) {
	runtime.HandleFunc("POST /api/auth/login", authNotConfigured)
	runtime.HandleFunc("POST /api/auth/logout", authNotConfigured)
	runtime.HandleFunc("POST /api/auth/forgot-password", authNotConfigured)
	runtime.HandleFunc("POST /api/auth/reset-password", authNotConfigured)
}

func authNotConfigured(w http.ResponseWriter, r *http.Request) {
	notConfigured(w, r, "add user storage, sessions, CSRF checks, and mail before enabling authentication")
}
