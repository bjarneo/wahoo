package app

import (
	"net/http"

	"github.com/bjarneo/wahoo/realtime"
	"github.com/bjarneo/wahoo/server"
)

// Events publishes server-sent events for this application process.
var Events = realtime.NewHub()

func registerSSE(runtime *server.Server) {
	runtime.HandleFunc("GET /events", sseNotConfigured)
}

func sseNotConfigured(w http.ResponseWriter, r *http.Request) {
	notConfigured(w, r, "configure authentication, tenant authorization, topic selection, and connection limits before enabling SSE")
}
