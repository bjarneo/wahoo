package app

import (
	"net/http"

	"github.com/bjarneo/wahoo/server"
)

func registerWebSocket(runtime *server.Server) {
	runtime.HandleFunc("GET /ws", webSocketNotConfigured)
}

func webSocketNotConfigured(w http.ResponseWriter, r *http.Request) {
	notConfigured(w, r, "configure authentication, origin rules, message policy, and connection limits before enabling WebSocket")
}
