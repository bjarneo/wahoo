package app

import (
	"net/http"

	"github.com/bjarneo/wahoo/server"
)

func registerWebSocket(runtime *server.Server) {
	runtime.HandleFunc("GET /ws", webSocketNotConfigured)
}

func webSocketNotConfigured(w http.ResponseWriter, _ *http.Request) {
	http.Error(w, "configure authentication, origin rules, and connection limits before enabling WebSocket", http.StatusNotImplemented)
}
