package main

import (
	"context"
	"log/slog"
	"net/http"
	"os"

	"__MODULE__/app"
	"__MODULE__/internal/ssr"
	"github.com/bjarneo/wahoo/server"
)

func main() {
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil))
	runtime := server.New(server.Config{
		Addr:   env("PORT", ":8080"),
		Logger: logger,
	})
	runtime.SetRenderer(ssr.NewRenderer())
	runtime.Handle("GET /assets/", http.StripPrefix("/assets/", http.FileServer(http.Dir("web/dist/assets"))))

	app.Register(runtime)
	if err := runtime.Run(context.Background()); err != nil {
		logger.Error("server stopped", "err", err)
		os.Exit(1)
	}
}

func env(key, fallback string) string {
	if value := os.Getenv(key); value != "" {
		return value
	}
	return fallback
}
