{
  "name": "__APP_NAME__-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ssr\" \"npm:dev:go\"",
    "dev:ssr": "node dev-server.mjs",
    "dev:go": "WAHOO_SSR_URL=http://127.0.0.1:4173/__wahoo_ssr go run ..",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start:ssr": "node ssr-server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
